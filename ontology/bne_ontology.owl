    <rdfs:label xml:lang="en">has left</rdfs:label>
    <rdfs:comment>The participants on the left side of relationship.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#left"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdfs:range rdf:nodeID="N387b21fc061b4700a039aead5b917742"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/CoExpression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <rdfs:comment>A relationship where two genes or proteins are expressed under similar conditions, implying potential co-regulation.</rdfs:comment>
    <rdfs:label>Co-expression</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MI_2231"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
