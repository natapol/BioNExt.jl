    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:comment>the human-readable name of entity.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.uniprot.org/core/name"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </rdf:Description>
