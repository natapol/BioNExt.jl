   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/encodedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">encoded by</rdfs:label>
    <rdfs:comment>Indicates a relation of two object when the first object is a product of the second object.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://semanticscience.org/resource/SIO_010079"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <owl:inverseOf rdf:resource="https://w3id.org/bionext/ontology/encodes"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7737f2b61c524dc592491cd81bb3ce8a">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdf:rest rdf:nodeID="N803b0610f67a477d83e2094949092cbf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/ERGogiIntermediateCompartment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A transient membrane-bound compartment located between the endoplasmic reticulum and Golgi apparatus that facilitates protein trafficking.</rdfs:comment>
    <rdfs:label>ER-Golgi intermediate compartment</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005793"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Provenance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Provenance</rdfs:label>
    <rdfs:comment>A metadata that describing the sources, entities, agents, and activities involved in the creation, modification, or derivation of RDF data.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/prov-o/"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Gene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Gene</rdfs:label>
    <rdfs:comment>A sequence of DNA that contains the necessary information to produce a functional product, typically a protein or functional Rna.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:subClassOf rdf:nodeID="Ne3fda9ac35e340278a616d2509eabbaf"/>
    <rdfs:subClassOf rdf:nodeID="Nc0c1bd31323a42b78d523c45c204a533"/>
    <rdfs:subClassOf rdf:nodeID="N876c7bd25e39438c86e45f73bd8cc23f"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#Gene"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Complex"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Naca642d419fb42879650b7d3e85b4e78">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdf:rest rdf:nodeID="N81d696e5e9f149d090209b8a87030b95"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/DoubleStrandedRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>Genetic material consisting of two complementary RNA strands base-paired into a double helix, often encapsulated by viral capsid proteins, which triggers antiviral responses including RNA interference</rdfs:comment>
    <rdfs:label>dsRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000965"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/MicroRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>A non-coding RNA regulates gene expression post-transcriptionally by binding to target mRNAs and inhibiting translation or promoting degradation.</rdfs:comment>
    <rdfs:label>miRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000276"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd40e6c5a3fa44fc8848325179809d4f8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N715a29faf97f437597256a07a68ad5f9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/isVariantOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is variant of</rdfs:label>
    <rdfs:comment>Relates a biological variant to the reference sequence, gene, or entity from which it is derived. This property indicates that the subject represents a modified form (e.g., mutation, polymorphism, or alteration) of the object, typically described using standardized nomenclature such as HGVS. It is used to link a specific variant instance to its canonical or reference counterpart.</rdfs:comment>
    <rdfs:domain rdf:nodeID="Nbf0c324019cd44b391a6926a568171a1"/>
    <rdfs:range rdf:nodeID="N91b7687dc3644245abd772ef8fee6993"/>
    <owl:inverseOf rdf:resource="https://w3id.org/bionext/ontology/hasVariant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Enhancer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>A DNA sequence that increases transcription levels of a gene from a distance., Acts over distance to increase gene transcription.</rdfs:comment>
    <rdfs:label>Enhancer</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000165"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/TransferRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>Adapter molecule that translates mRNA codons into amino acids during protein synthesis.</rdfs:comment>
    <rdfs:label>tRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000253"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/SmallNuclearRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>A non-coding RNA which is an essential component of the spliceosome involved in pre-mRNA splicing.</rdfs:comment>
    <rdfs:label>snRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000274"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Autophagosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A double-membrane vesicle that encloses cytoplasmic material and organelles for delivery to lysosomes during autophagy.</rdfs:comment>
    <rdfs:label>autophagosome</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005776"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf80ba439e4aa4db08ff123aca2d83ec1">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N565b8cd31a2b405cb4fcf7c4563309e4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/isVariantOf"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N875a603e782c4885b6a6fe334fe944d9">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Expression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:comment>The process in which a gene's sequence is converted into a mature gene product (protein or RNA). This includes the production of an RNA transcript and its processing, as well as translation and maturation for protein-coding genes.</rdfs:comment>
    <rdfs:label>Expression</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO:0010467"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/PositiveCorrelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CoExpression"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdfs:comment>The relationship that one gene's expression level increases across samples, the other gene's expression also increases.</rdfs:comment>
    <rdfs:label>Positive Correlation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CoExpression"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb51234fa7c2c41d78fbe23579c96d374">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="Na5d8c4ff08b649029db65c96271eb513"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nae3cde7e642c4d7aa2e0e9ea42f14b21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/hasLeft"/>
    <owl:allValuesFrom rdf:nodeID="N2642db6547b540cbb510947a40432cc8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Association">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <rdfs:comment>A general relationship where entities are observed together in a context suggesting possible biological linkage.</rdfs:comment>
    <rdfs:label>Association</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MI_0915"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasCofactor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has cofactor</rdfs:label>
    <rdfs:comment>Associates a molecule with a required cofactor.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.uniprot.org/core/cofactor"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N81d696e5e9f149d090209b8a87030b95">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has function</rdfs:label>
    <rdfs:comment>the information of  a gene to its function term sourced from external datasets (e.g., imported annotations)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/EdgeEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Edge entity</rdfs:label>
    <rdfs:comment>An occurrent entity describing a biological association that captures interactions or influences between participating entities. This includes relationships between NodeEntities as well as more general influence relationships that may extend to EdgeEntity or PathwayModule. This class serves as a unifying superclass for both direct molecular interactions and higher-level causal or regulatory relationships.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
    <rdfs:subClassOf rdf:nodeID="Na03fee097cb74b4f9c49e46d63302120"/>
    <rdfs:subClassOf rdf:nodeID="N4a260d63177c49c593654b8a1e8c9d02"/>
    <rdfs:subClassOf rdf:nodeID="N0f6d02614382408fab1ee975da397763"/>
    <rdfs:subClassOf rdf:nodeID="Nae3cde7e642c4d7aa2e0e9ea42f14b21"/>
    <rdfs:subClassOf rdf:nodeID="N5f1407f6edef4388b40519cceb8a09d0"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#Interaction"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasProteinMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has protein member</rdfs:label>
    <rdfs:comment>Identifies individual protein members of a gene or ortholog group.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/bionext/ontology/hasMember"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0259cf2c37c8431b91a354b8325ac163">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Complex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Biomolecular complex</rdfs:label>
    <rdfs:comment>A  physical entity representing a stable assembly of molecular components that collectively perform a biological function. Such assemblies are characterized by sustained or regulatory interactions between components and exclude transient, short-lived associations involved solely in catalytic processes.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#Complex"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Fusion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdfs:comment>A relationship of a hybrid gene or gene product formed from two previously separate genes, typically due to chromosomal rearrangements such as translocations or deletions.</rdfs:comment>
    <rdfs:label>Fusion</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000806"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/OrthologGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Protein ortholog groups</rdfs:label>
    <rdfs:comment>A collection of proteins from different species that are orthologs, often identified from databases like OrthoDB or EggNOG. Represents evolutionary conserved protein functions across species.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:seeAlso rdf:resource="http://purl.org/net/orth#OrthologsCluster"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Complex"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Reversible">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <rdfs:comment>A reaction rate  always refers to a  reversible  direction (forward and reverse). They can proceed in both directions.</rdfs:comment>
    <rdfs:label>reversible reaction</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://biomodels.net/SBO/SBO_0000156"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Catalysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Complex"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Reaction"/>
    <rdfs:comment>A relationship where one entity, typically an enzyme, facilitates a reaction involving another entity without being consumed.</rdfs:comment>
    <rdfs:label>Catalysis</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0003824"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na85560537ecb488faf3e1a42f0b48ed5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/hasHGVS"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/RelationshipType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
    <rdfs:label>Relationship type</rdfs:label>
    <rdfs:comment>A controlled vocabulary of classes representing biological interactions and relationships between two NodeEntities, used to define the RelationshipType class in RDF. The controlled vocabulary ontology can be MI, PSIMOD, GO, and etc.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#RelationshipTypeVocabulary"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/CellularLocation"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/RegionType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/SmallMolecule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Small molecule element</rdfs:label>
    <rdfs:comment>A physical entity representing a collection of non-nucleic acid, non-protein molecules, characterized by a defined chemical structure, including small molecules and non-genomically encoded macromolecules.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#SmallMolecule"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Complex"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Influence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>influence</rdfs:label>
    <rdfs:comment>An occurrent entity representing a directed influence whereby a source entity modulates, activates, inhibits, or otherwise alters the state or behavior of a target entity. The target may be another EdgeEntity or a higher-level construct such as a PathwayModule.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdfs:subClassOf rdf:nodeID="Nc7fe46887f3849719f46ffefca4245b3"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#Control"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Interaction"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Reaction"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Dissociation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:comment>A relationship where entities previously bound together become separated, indicating a loss of interaction.</rdfs:comment>
    <rdfs:label>Dissociation</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/INO_0000092"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne571436b8fd34360bf33f2c6ce854c56">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="Nc8f49845ec4443e2885a4c9eb9768388"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/ExtracellularMatrix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A complex network of proteins and polysaccharides located outside the plasma membrane that provides structural support and mediates cell signaling.</rdfs:comment>
    <rdfs:label>Extracellular Matrix</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0031012"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Entity</rdfs:label>
    <rdfs:comment>An abstract superclass representing any discrete biological or conceptual entity used to describe pathway systems. This class encompasses occurrents (e.g., pathways and processes,  interactions), continuants (e.g., physical entities such as genes or proteins).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#Entity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/ExtracellularVesicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>Any vesicle that is part of the extracellular region</rdfs:comment>
    <rdfs:label>Extracellular Vesicle</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_1903561"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/isIsoformOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is isoform of</rdfs:label>
    <rdfs:comment>Relates an isoform to the canonical protein or gene from which it is derived. This property indicates that the subject represents a specific isoform, arising from processes such as alternative splicing, alternative promoter usage, or post-transcriptional variation, of the reference entity given as the object.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/ORF">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>A sequence of DNA that could potentially encode a protein, starting with a start codon and ending with a stop codon., Potential protein-coding frame bounded by start and stop codons.</rdfs:comment>
    <rdfs:label>Open Reading Frame (ORF)</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000236"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Degradation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:comment>A process in which a biological molecule, such as a protein, RNA, or metabolite, is broken down into simpler components, leading to loss of its original function or structure.</rdfs:comment>
    <rdfs:label>Degradation</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0044265"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/FivePrimeCap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>Cap added to the 5′ end of mRNA for protection and translation.</rdfs:comment>
    <rdfs:label>5' Cap</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000581"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/collectedDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">collected date</rdfs:label>
    <rdfs:comment>Records the date and time on which the information was collected or obtained from its source.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#generatedAtTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Provenance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/AntisenseRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>RNA molecules are commonly noncoding and play regulatory roles through base-pairing interactions or transcriptional interference.</rdfs:comment>
    <rdfs:label>asRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000644"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Irreversible">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <rdfs:comment>A reaction rate  always refers to a single direction (forward or reverse)</rdfs:comment>
    <rdfs:label>irreversible reaction</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://biomodels.net/SBO/SBO_0000153"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/PiwiInteractingRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>A non-coding RNA protects genome integrity in germ cells by silencing transposable elements.</rdfs:comment>
    <rdfs:label>piRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0001035"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Interaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Interaction</rdfs:label>
    <rdfs:comment>An occurrent entity representing an association between two or more biological entities that results in a change or influence on their state, function, or behavior. Interactions may involve physical contact, information transfer, or indirect functional relationships.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdfs:subClassOf rdf:nodeID="Nf49115502f504902bb256f319a4079ca"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Reaction"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Influence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Repression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdfs:comment>A relationship where one entity negatively regulates or suppresses the gene expression of another.</rdfs:comment>
    <rdfs:label>Repression</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0010629"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N876c7bd25e39438c86e45f73bd8cc23f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/isVariantOf"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasVariant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has variant</rdfs:label>
    <rdfs:comment>A  gene or gene product to a specific sequence variant described using HGVS notation (e.g., cDNA, protein, or genomic level). The object is an RDF resource identified by a unique identifier combining the protein or gene accession and the HGVS expression (e.g., UniProt:P04637_p.R273H).</rdfs:comment>
    <rdfs:domain rdf:nodeID="N104972302eb242019afcafdea6707dbc"/>
    <rdfs:range rdf:nodeID="N230eb60326eb4fd48653212eaecd497a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/EnhancerRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>Non-coding RNA transcribed from enhancer regions; modulates transcription of target genes.</rdfs:comment>
    <rdfs:label>eRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0001870"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/CoOccurence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:comment>A relationship where two entities are repeatedly observed together across different datasets or conditions.</rdfs:comment>
    <rdfs:label>Co-occurrence</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/CellWall">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>a polarized stack of flattened membrane-bound cisternae, with associated vesicles, involved in modifying, sorting, and packaging proteins and lipids. It has a cis (receiving) face and a trans (shipping) face, reflecting its role in intracellular transport.</rdfs:comment>
    <rdfs:label>cell wall</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005618"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/CellComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellularLocation"/>
    <rdfs:comment>The location relative to cellular structures in which a gene product performs a function, either cellular compartments (such as the nucleus, mitochondrion, or extracellular space) or stable macromolecular complexes (such as a ribosome or proteasome).</rdfs:comment>
    <rdfs:label>Cellular Component</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005575"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellularLocation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/TelomeraseRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>a non-coding template RNA component of telomerase that directs telomere repeat synthesis at chromosome ends.</rdfs:comment>
    <rdfs:label>Telomerase RNA component (TERC)</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000390"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/SmoothER">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>An interconnected network of membrane-bound tubules lacking ribosomes, involved in lipid synthesis, detoxification, and calcium storage.</rdfs:comment>
    <rdfs:label>smooth endoplasmic reticulum</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005790"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/organism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">organism</rdfs:label>
    <rdfs:comment>Identifies the organism to which the entity belongs.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#organism"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Taxon"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Increase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdfs:comment>A relationship where one biological entity enhances, promotes, or elevates the activity, expression, or abundance of another.</rdfs:comment>
    <rdfs:label>Increase</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MI_2237"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Peroxisome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A small, single-membrane-bound organelle containing enzymes for lipid metabolism and the detoxification of hydrogen peroxide.</rdfs:comment>
    <rdfs:label>peroxisomes</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005777"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/SmallInterferingRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>A non-coding RNAs that induce  the degradation of complementary mRNA molecules through the RNA interference pathway.</rdfs:comment>
    <rdfs:label>siRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000646"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Protein">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Protein element</rdfs:label>
    <rdfs:comment>A physical entity consisting of a single polypeptide chain or protein monomer, defined by an amino acid sequence, describing a protein. Examples: EGFR (epidermal growth factor receptor), insulin.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:subClassOf rdf:nodeID="Nea5621d8d9d74231a9c75855c10c0c31"/>
    <rdfs:subClassOf rdf:nodeID="N8019ac59a911477484b1546716404287"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#Protein"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5119c98d8463410b9abf0cfceb096ffb">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <rdf:rest rdf:nodeID="N67f5ec5629d045c1acb3953cbf40c490"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Enhancement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdfs:comment>A genetic relationship where combined mutations result in a stronger or more severe phenotype than expected.</rdfs:comment>
    <rdfs:label>Enhancement</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MI_1131"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has source</rdfs:label>
    <rdfs:comment>Identifies the original source from which the information was obtained, such as a URL, book, paper, database, or report.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/source"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Provenance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Intron">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>A non-coding segment within a gene that is removed during RNA splicing., Non-coding DNA spliced out during mRNA processing.</rdfs:comment>
    <rdfs:label>Intron</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000188"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/pathwayComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">pathwayComponent</rdfs:label>
    <rdfs:comment>The set of interactions and relationships  in the pathway/network.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#pathwayComponent"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <rdfs:range rdf:nodeID="N31b62ec5de4640abb0dece5476b1f82e"/>
    <owl:inverseOf rdf:resource="https://w3id.org/bionext/ontology/participatesInPathway"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Phosphorylation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <rdfs:comment>A protein modification that effectively replaces a hydrogen atom with a phosphono group (H2PO3 or 'phosphate').</rdfs:comment>
    <rdfs:label>Phosphorylation</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MOD_00696"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/MessengerRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>Encodes the genetic blueprint transcribed from DNA and delivers it to ribosomes for protein synthesis.</rdfs:comment>
    <rdfs:label>mRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000234"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na03fee097cb74b4f9c49e46d63302120">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/hasType"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">BioNExt Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">An ontology for representing biological entities, pathway participation, orthologous relationships, evidence, and cross-database integration for yeast and human biological models.
</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://w3id.org/bionext/releases/v1.0.0/bionext.ttl"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-13</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-06</dct:modified>
    <dct:creator rdf:resource="https://orcid.org/0009-0003-1344-2449"/>
    <dct:publisher rdf:resource="https://s3bio.gitlab.io/"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-13</dct:issued>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Cytoskeleton">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A structural framework within the cytoplasm that includes actin filaments, microtubules, and intermediate filaments, essential for maintaining cell shape, intracellular transport, and signal transduction.</rdfs:comment>
    <rdfs:label>cytoskeleton</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005856"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Dna">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Dna  element</rdfs:label>
    <rdfs:comment>A physical entity consisting of deoxyribonucleotide monophosphates. Represents a pool of DNA molecules. Use DnaRegion for subregions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:subClassOf rdf:nodeID="Nda28e89084ed4895ba7d59b9858c95c2"/>
    <rdfs:subClassOf rdf:nodeID="N911cede110724dd6a5279c5075b185d7"/>
    <rdfs:subClassOf rdf:nodeID="N565b8cd31a2b405cb4fcf7c4563309e4"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#Dna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Complex"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N721a44451a5a4e5a9fbf6b4973cd9eb8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/hasRegion"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8fca68ecd0fe48a9acd1165c2a411fac">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <rdf:rest rdf:nodeID="N1d1f280c3a484f8abf9101575e9e3090"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/encodes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">encodes</rdfs:label>
    <rdfs:comment>A relation between two objects, in which the first object contains information that is used to produce the second object.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://semanticscience.org/resource/SIO_010078"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <owl:inverseOf rdf:resource="https://w3id.org/bionext/ontology/encodedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/RiboswitchRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>a noncoding RNA domains that are typically found embedded in messenger RNAs, where they sense specific target molecules or elemental ions and regulate gene expression</rdfs:comment>
    <rdfs:label>RiboswitchRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000035"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Vesicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A small, membrane-enclosed sac within the cytoplasm, used to transport proteins, lipids, and other molecules between organelles or to the plasma membrane, playing a central role in exocytosis, endocytosis, and intracellular signaling pathways.</rdfs:comment>
    <rdfs:label>Vesicle</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0031982"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasConfidenceScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has confidence score</rdfs:label>
    <rdfs:comment>Score representing confidence in the annotation or relationship.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://w3id.org/biolink/vocab/ConfidenceLevel"/>
    <rdfs:domain rdf:nodeID="Nd40e6c5a3fa44fc8848325179809d4f8"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/createdBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">created by</rdfs:label>
    <rdfs:comment>Identifies the person, organization, software, or other agent responsible for creating or recording the information.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Provenance"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/created">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/annotates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">annotates</rdfs:label>
    <rdfs:comment>Represents a relationship where a DNA region provides annotation, reference, or mapping to a gene, indicating functional, positional, or regulatory linkage. Commonly used to associate genomic features such as promoters or enhancers with their related genes.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Rna">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Rna  element</rdfs:label>
    <rdfs:comment>A physical entity consisting of ribonucleotide monophosphates. Represents a pool of Rna molecules. Use RnaRegion for subregions. Examples: let-7 microRna, mRna, rRna.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:subClassOf rdf:nodeID="N04a04d12e6a34905b75854e8e84471c8"/>
    <rdfs:subClassOf rdf:nodeID="N721a44451a5a4e5a9fbf6b4973cd9eb8"/>
    <rdfs:subClassOf rdf:nodeID="Nac00fca1c388491e940cb651d86263a1"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#Rna"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Complex"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/participatesInPathway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">participates in Pathway</rdfs:label>
    <rdfs:comment>Relates a biological entity (e.g., gene, protein, metabolite, or complex) and biological interaction to a biological pathway in which it participates. This property indicates that the subject plays a role in the processes or interactions represented by the pathway, such as signaling, metabolic, or regulatory pathways.</rdfs:comment>
    <rdfs:domain rdf:nodeID="N28018a98732d4c1cb88eba594787a941"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/bionext/ontology/participatesIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/YRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>Involved in initiation of DNA replication and RNA quality control in conjunction with Ro60 protein.</rdfs:comment>
    <rdfs:label>YRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000405"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne3fda9ac35e340278a616d2509eabbaf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/hasVariant"/>
    <owl:allValuesFrom rdf:nodeID="N2b56590ff95e49f68b58b69cec8896b9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/SignalCrosstalk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:comment>A relationship where one signaling pathway influences another,</rdfs:comment>
    <rdfs:label>Signal Crosstalk</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Cytoplasm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>The part of the cell contained within the entire plasma membrane, excluding the nucleus, and composed of the cytosol and all organelles except the nucleus and their contents.</rdfs:comment>
    <rdfs:label>cytoplasm</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005737"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Ribosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A small, non-membrane-bound macromolecular complex composed of rRNA and proteins that synthesizes proteins by translating mRNA.</rdfs:comment>
    <rdfs:label>ribosome</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005840"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Methylation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <rdfs:comment>The process in which a methyl group is covalently attached to a molecule.</rdfs:comment>
    <rdfs:label>Methylation</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0032259"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb99b6cbb960c4fd88945c096abcaf7c6">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdf:rest rdf:nodeID="N3c028a1114824cc0aa55a640f46a81ff"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N138f27b5bfc947e1904b53d34810b121">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N48c7392a33924e17a8d97ddfd72fe7f6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/CellularLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
    <rdfs:label>Cellular location</rdfs:label>
    <rdfs:comment>A controlled vocabulary class describing the location of a biological entity within or around a cell, based on standardized Gene Ontology cellular component terms. This includes subcellular compartments, macromolecular structures, and extracellular regions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#CellularLocationVocabulary"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/RegionType"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2642db6547b540cbb510947a40432cc8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N184bb5845e1543a0864b904754cc8ae1"/>
  </rdf:Description>
