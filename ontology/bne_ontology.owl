    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">expected participant</rdfs:label>
    <rdfs:comment>Non-logical metadata listing an allowed participant class for a relationship type; multiple values represent alternatives.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N184bb5845e1543a0864b904754cc8ae1">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdf:rest rdf:nodeID="N7737f2b61c524dc592491cd81bb3ce8a"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Endosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A membrane-bound vesicular structure involved in the internalization and sorting of materials taken up by endocytosis, forming an intermediate compartment between the plasma membrane and lysosomes.</rdfs:comment>
    <rdfs:label>Endosome</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005768"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Vacuole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A membrane-bound organelle prominent in plant and fungal cells, involved in storage, degradation, and maintaining turgor pressure.</rdfs:comment>
    <rdfs:label>vacuole</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005773"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Activation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <rdfs:comment>A relationship where one entity increases or initiates the activity or function of another (e.g., gene, protein).</rdfs:comment>
    <rdfs:label>Activation</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/INO_0000024"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
