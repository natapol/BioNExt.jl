  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/CircularRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>A non-coding single-stranded RNAs, covalently closed RNA with regulatory function.</rdfs:comment>
    <rdfs:label>circRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0002291"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/PathwayModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Pathway module</rdfs:label>
    <rdfs:comment>a set of molecular interactions, reactions, or sub-processes serving a specific biological role that groups together related interactions, reactions, or sub-processes serving a specific biological role.</rdfs:comment>
