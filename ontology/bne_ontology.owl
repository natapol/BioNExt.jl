    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Lysosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>the spherical, membrane-bound organelles containing hydrolytic enzymes active at low pH. They function as the digestive system of the cell, breaking down waste, macromolecules, and cellular debris.</rdfs:comment>
    <rdfs:label>lysosome</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005764"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/ControlledVocabulary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>Contolled vocabulary</rdfs:label>
    <rdfs:comment>A class representing a controlled and managed vocabulary of terms used for the consistent annotation and integration of biological data. It encompasses both locally defined terms and externally sourced ontology classes that are incorporated to enable interoperability across systems.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#ControlledVocabulary"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
  </rdf:Description>
