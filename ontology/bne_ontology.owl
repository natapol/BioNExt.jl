    <owl:intersectionOf rdf:nodeID="Nf185d8fedaed464094232bbfb2a39a5b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has member</rdfs:label>
    <rdfs:comment>Specifies members that are part of a group or collection.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
