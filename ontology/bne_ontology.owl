    <owl:unionOf rdf:nodeID="N82d0edc09a2349cc9c77e92d4383d565"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Mitochondria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>the double-membraned organelles with an outer membrane and a highly folded inner membrane forming cristae, enclosing a protein-rich matrix. Their elongated shape and internal complexity reflect their role in ATP production through aerobic respiration.</rdfs:comment>
    <rdfs:label>mitochondria</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005739"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
