    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">expected right participant type</rdfs:label>
    <rdfs:comment>Non-logical metadata listing an allowed right-participant class for a relationship type; multiple values represent alternatives.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/bionext/ontology/expectedParticipant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Indirect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <rdfs:comment>The relationship is known to occur through one or more intermediate biological steps that are not explicitly resolved.</rdfs:comment>
    <rdfs:label>Indirect</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MI_2286"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasInChIKey">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has InChI Key</rdfs:label>
    <rdfs:comment>Stores the hashed InChIKey version of the chemical identifier.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://semanticscience.org/resource/CHEMINF_000059"/>
