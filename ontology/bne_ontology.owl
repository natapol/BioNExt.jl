  <rdf:Description rdf:nodeID="N079e626905c34e8790c599b80e42b4e1">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <rdf:rest rdf:nodeID="Nc3dd31de4d8b4eb48cf45423f75d67e0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/memberOfComplex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">member of Complex</rdfs:label>
    <rdfs:comment>Relates a biological entity (e.g., protein, RNA, or other molecule) to a molecular complex of which it is a constituent member. This property indicates that the subject participates as a component of the specified complex, contributing to its structure and/or function.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Complex"/>
    <owl:inverseOf rdf:resource="https://w3id.org/bionext/ontology/hasSubunit"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/bionext/ontology/participatesIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasSpeciesCoverage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has species coverage</rdfs:label>
    <rdfs:comment>A set of species that related to the domain</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Taxon"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0df973cbf5a74dd1aaffc714ef344276">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="Naca642d419fb42879650b7d3e85b4e78"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Decrease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdfs:comment>A relationship where one biological entity reduces, inhibits, or diminishes the activity, expression, or abundance of another.</rdfs:comment>
    <rdfs:label>Decrease</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MI_2242"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Suppression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdfs:comment>A genetic relationship where a mutation in one gene compensates for or rescues the phenotype of a mutation in another gene.</rdfs:comment>
    <rdfs:label>Suppression</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MI_1130"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/StateTransition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <rdfs:comment>A biological event in which the same biological entity changes its state without becoming a different entity. The change may involve its location or membrane orientation, conformation or molecular modification state, or functional activity.</rdfs:comment>
    <rdfs:label>State transition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Insulator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>A DNA element that blocks interactions between enhancers and unrelated promoters., Defines regulatory boundaries between domains.</rdfs:comment>
    <rdfs:label>Insulator</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000627"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/modificationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">modification type</rdfs:label>
    <rdfs:comment>Specifies the type of modification represented by a biological entity. This property categorizes the nature of a change or alteration (e.g., chemical modification, structural modification, or sequence alteration), providing a broader classification than mutation-specific terms and allowing description of both genetic and non-genetic modifications.</rdfs:comment>
    <rdfs:domain rdf:nodeID="Nb51234fa7c2c41d78fbe23579c96d374"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/modifiedDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">modified date</rdfs:label>
    <rdfs:comment>Records the date and time when the information was most recently modified.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/modified"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Provenance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfcb4b87721d940498fb154e20d41a583">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/hasRight"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/derivedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">derived from</rdfs:label>
    <rdfs:comment>Identifies another resource, dataset, or information item from which the current information was derived.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Provenance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasWeight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has weight</rdfs:label>
    <rdfs:comment>Indicates the significance value assigned to an edge or interaction, representing its relative strength, reliability, or importance within a network. Typically expressed as a floating-point number.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
