    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">start position</rdfs:label>
    <rdfs:comment>Relates a sequence feature to an object that represents its start coordinate on a reference sequence.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0002516"/>
    <rdfs:seeAlso rdf:resource="http://biohackathon.org/resource/faldo#begin"/>
