  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasSeq">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has sequence</rdfs:label>
    <rdfs:comment>Holds the nucleotide or amino acid sequence as a string.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.bioassayontology.org/bao#BAO_0002817"/>
    <rdfs:domain rdf:nodeID="N115779c8e39045a2bf4eaa6f21f3fb29"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Inhibition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <rdfs:comment>A relationship where one entity reduces, blocks, or suppresses the activity or function of another (e.g. gene, protein).</rdfs:comment>
    <rdfs:label>Inhibition</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/INO_0000124"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Nucleolus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A sub-nuclear body where ribosomal RNA is synthesized and ribosome assembly begins, serving as a critical node for protein biosynthesis.</rdfs:comment>
    <rdfs:label>Nucleolus</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005730"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
