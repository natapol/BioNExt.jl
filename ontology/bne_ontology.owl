    <owl:unionOf rdf:nodeID="Na005a12ff2ee47d3935eab2e99bd5f0b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/RnaRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RegionType"/>
    <rdfs:label>Rna region</rdfs:label>
    <rdfs:comment>A controlled vocabulary class describing a defined subregion of an RNA molecule. An RnaRegion is not a pool of discrete molecular entities but a dependent segment that exists only as part of a larger RNA molecule and is defined by its positional or functional context.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RegionType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N48c7392a33924e17a8d97ddfd72fe7f6">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <rdf:rest rdf:nodeID="N20da1e4b5a4a49b88f4462eee07eb7e1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasModificationSitedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has modification sited on</rdfs:label>
    <rdfs:comment>Specifies the amino acid residue and position where the protein is modified, expressed in text (e.g., 'Ser473', Ser473-phosphorylation”, “Lys9Ac"). The RDF object represented as an RDF resource identified by the protein accession and modification site (e.g., 'UniProt:P31749_Ser473', 'UniProt:P68431_Lys9Ac')</rdfs:comment>
    <rdfs:domain rdf:nodeID="N0df973cbf5a74dd1aaffc714ef344276"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/SevenSKRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>7SK is a highly conserved noncoding RNA of 331 nucleotides in animals. It  regulates transcription elongation by sequestering the positive transcription elongation factor b (P-TEFb).</rdfs:comment>
    <rdfs:label>7SK small nuclear RNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0002340"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/NoInteraction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdfs:comment>A relationship where the combined effect of two mutations shows no significant difference from their individual effects.</rdfs:comment>
    <rdfs:label>No interaction</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MI_2226"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/MissingInteraction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <rdfs:comment>An interaction expected in the reference pathway but absent, e.g. because of mutation.</rdfs:comment>
    <rdfs:label>Missing interaction</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/MI_0573"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
