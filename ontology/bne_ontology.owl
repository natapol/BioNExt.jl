    <rdf:rest rdf:nodeID="N2faa649a8d6340ddb7f3915d7ff9f03e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasDbXref">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has database cross reference</rdfs:label>
    <rdfs:comment>Indicates a cross-reference to an external database that provides additional information about the entity.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/ThreePrimeUTR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/UTR"/>
    <rdfs:comment>3′ region that affects stability and localization of mRNA., The 3' untranslated region downstream of the coding sequence in mRNA.</rdfs:comment>
    <rdfs:label>3' UTR</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000205"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/UTR"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/synonyms">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">synonyms</rdfs:label>
    <rdfs:comment>Alternative names or labels for the same entity.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Terminator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>A DNA sequence that signals the end of transcription., Marks the end of transcription by RNA polymerase.</rdfs:comment>
    <rdfs:label>Terminator</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000141"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/NodeEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Node entity</rdfs:label>
    <rdfs:comment>A biological entity representing a pool of molecules or complexes functioning as nodes in pathway models. A NodeEntity is defined by a canonical sequence or structural reference and is annotated with descriptive features, including cellular location, naming conventions, and literature evidence.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0fdea4dfc89349d09764b041e2708fb7">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Translation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:comment>The process by which a cell's machinery reads the genetic information on an mRNA molecule and synthesizes a protein from it.</rdfs:comment>
    <rdfs:label>Translation</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0006412"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5e3c5d7baba24fd3a5ffe6966c5e794e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/hasHGVS"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Apoptosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A multi-protein complex that forms in the cytoplasm during apoptosis and activates initiator caspases to trigger programmed cell death.</rdfs:comment>
    <rdfs:label>apoptosome</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0043293"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
