  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Exon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>A DNA sequence that remains in the mature RNA and may encode protein., Part of gene retained in mature RNA; may include coding or UTR.</rdfs:comment>
    <rdfs:label>Exon</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000147"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Silencer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>A regulatory element that represses transcription of a gene., Prevents transcription of nearby gene sequences.</rdfs:comment>
    <rdfs:label>Silencer</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000625"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5e3be726edfa4e548f79ba95120b2df8">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdf:rest rdf:nodeID="N59413afbced34489a5e0d40088493d4f"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/MultivesicularBody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A type of late endosome characterized by internal vesicles formed by inward budding, involved in sorting membrane proteins for degradation.</rdfs:comment>
    <rdfs:label>multivesicular bodies</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005771"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
