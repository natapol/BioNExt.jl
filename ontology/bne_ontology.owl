  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/PrecursorMiRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>Hairpin-shaped RNA processed in the nucleus and cytoplasm to produce mature microRNAs.</rdfs:comment>
    <rdfs:label>pre-miRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000185"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/SuccessiveReaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <rdfs:comment>A relationship between catalytic entities whose biochemical reactions occur successively and are connected through a shared intermediate compound.</rdfs:comment>
    <rdfs:label>Successive reaction relationship</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7c765e84984449b5b711cb90f13a57c7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="N4ec4c91578654ef9a0ad7512c31b14a6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/RibosomalRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>Forms the catalytic and structural core of ribosomes, facilitating peptide bond formation.</rdfs:comment>
    <rdfs:label>rRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000252"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/participatesInEdge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">participates in Edge</rdfs:label>
    <rdfs:comment>Relates an entity (e.g., gene, protein, or small molecule) to a specific interaction or relationship instance (edge) in which it participates. This property is used to associate biological entities with edges in a graph model, enabling representation of their roles within interactions such as binding, regulation, or signaling.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/bionext/ontology/participatesIn"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na005a12ff2ee47d3935eab2e99bd5f0b">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdf:rest rdf:nodeID="Nd5ee2e895d9a4246bce9ab25437197b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Reaction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Reaction</rdfs:label>
    <rdfs:comment>An occurrent entity representing a sequence of biochemical or cellular events that transforms input entities (substrates) into output entities (products), often mediated by enzymatic or regulatory mechanisms.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdfs:subClassOf rdf:nodeID="Nfcb4b87721d940498fb154e20d41a583"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#BiochemicalReaction"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Interaction"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/Influence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/RoughER">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A series of flattened membrane sacs studded with ribosomes, primarily responsible for the synthesis and initial folding of membrane-bound and secretory proteins.</rdfs:comment>
    <rdfs:label>rough endoplasmic reticulum</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005791"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N12068c960c3c47d794691a149ebe2ea2">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/PlasmaMembrane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>a dynamic, semi-permeable phospholipid bilayer containing embedded proteins and carbohydrates. It defines the cell boundary and regulates the transport of substances in and out of the cell.</rdfs:comment>
    <rdfs:label>plasma membrane</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005886"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/DnaRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RegionType"/>
    <rdfs:label>Dna region</rdfs:label>
    <rdfs:comment>A controlled vocabulary class describing a defined subregion of a DNA molecule. A DNARegion is not a pool of discrete molecular entities but a contextual segment that exists only as part of a larger DNA molecule and is defined by its relative position or functional role.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RegionType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasInChI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has InChI</rdfs:label>
    <rdfs:comment>Stores the IUPAC International Chemical Identifier (InChI).</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://semanticscience.org/resource/CHEMINF_000038"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
