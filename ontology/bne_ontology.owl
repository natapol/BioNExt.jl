    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">length</rdfs:label>
    <rdfs:comment>Specifies the number of nucleotides or residues in the feature.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.uniprot.org/core/length"/>
    <rdfs:domain rdf:nodeID="N3d99cb5684134eeca8fd3febec61d617"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfc89408944954e4b8a3131211e259ec4">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdf:rest rdf:nodeID="Nfabdeef96fa74f08bfb4826a8173ebd1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/TranscriptionTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <rdfs:comment>The process by which the genetic information stored in DNA is copied into a new molecule of messenger RNA (mRNA).</rdfs:comment>
    <rdfs:label>Transcription to</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0009299"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasProvenance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has provenance</rdfs:label>
    <rdfs:comment>Links an entity to provenance information describing the source, origin, collection, creation, or modification of the entity's data.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Provenance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Dimerization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:comment>A relationship that two proteins bind together to form a functional unit</rdfs:comment>
    <rdfs:label>Dimerization</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0046983"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2374d458ea9040db8f6f5ffca3452d8b">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <rdf:rest rdf:nodeID="N875a603e782c4885b6a6fe334fe944d9"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasOrthologGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has ortholog group</rdfs:label>
    <rdfs:comment>Links an entity (e.g., a gene or protein) to the identifier of its ortholog group, representing a set of evolutionarily conserved homologs across species.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.org/net/orth#hasOrtholog"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/OrthologGroup"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7f537811168b466ab9a0450f2b85ad44">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasSmiles">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has SMILES</rdfs:label>
    <rdfs:comment>Stores the SMILES (Simplified Molecular-Input Line-Entry System) notation.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://semanticscience.org/resource/CHEMINF_000020"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/NegativeCorrelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CoExpression"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdfs:comment>The relationship that when one gene's expression goes up, the other's consistently goes down</rdfs:comment>
    <rdfs:label>Negative Correlation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CoExpression"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/LysosomalMembrane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>The lipid bilayer enclosing the lysosome, containing proteins essential for substance transport and maintaining acidic conditions required for lysosomal degradation.</rdfs:comment>
    <rdfs:label>Lysosomal Membrane</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005765"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf98461ce34fb4821a94a490e2069c9e6">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdf:rest rdf:nodeID="Nc294cf009dec4482a8df72a57b755365"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Ubiquitination">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:comment>A relationship where one protein catalyzes the covalent addition of ubiquitin to another protein.</rdfs:comment>
    <rdfs:label>Ubiquitination</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0016567"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Binding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:comment>A physical relationship where two or more entities interact via molecular binding (e.g., protein-protein, protein-DNA).</rdfs:comment>
    <rdfs:label>Binding</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005488"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/RegionType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
    <rdfs:label>Region type</rdfs:label>
    <rdfs:comment>A controlled vocabulary class describing a defined a classification of sequence regions, independent of whether they occur in DNA or RNA.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#SequenceRegionVocabulary"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/CellularLocation"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/VaultRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>A non-coding small RNA associated with vault complexes; its exact biological function remains unclear.</rdfs:comment>
    <rdfs:label>vtRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0002040"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasCasNum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has CAS number</rdfs:label>
    <rdfs:comment>the object has an identifier used by the Chemical Abstracts Service database.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://semanticscience.org/resource/CHEMINF_00044"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasNetCharge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has net charge</rdfs:label>
    <rdfs:comment>The overall electrical charge of a chemical entity after considering all atoms and charged groups in the represented chemical structure.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://semanticscience.org/resource/CHEMINF_000120"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/SmallMolecule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/NuclearPoreComplex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A large protein complex that spans the nuclear envelope, regulating the bidirectional transport of molecules between the nucleus and cytoplasm.</rdfs:comment>
    <rdfs:label>Nuclear Pore Complex</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005643"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0f6d02614382408fab1ee975da397763">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/bionext/ontology/hasLeft"/>
    <owl:someValuesFrom rdf:nodeID="N8268f410aef44336b7db3a8af75b716d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Nucleus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
    <rdfs:comment>A membrane-bounded organelle of eukaryotic cells in which chromosomes are housed and replicated.</rdfs:comment>
    <rdfs:label>nucleus</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0005634"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/CellComponent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N403f678d32ad4eb9803ea93291fb3821">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="N26b7abcc2c3a431dbd9c5c287d8aa1c2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasTemplate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has template</rdfs:label>
    <rdfs:comment>Indicates that the subject entity is derived from or synthesized using the object entity as a template. For example, DNA is a template for RNA during transcription, or a gene is derived from a DNA sequence.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Gene"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <owl:inverseOf rdf:resource="https://w3id.org/bionext/ontology/annotates"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/LongNonCodingRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>A non-coding RNA regulates transcription, epigenetic modification, and mRNA splicing without encoding proteins.</rdfs:comment>
    <rdfs:label>lncRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0001877"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3c028a1114824cc0aa55a640f46a81ff">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/CDS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>The portion of a gene's DNA or RNA that is translated into protein., Translated portion of exon that encodes protein.</rdfs:comment>
    <rdfs:label>Coding Sequence (CDS)</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000316"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6cf3cee8d705460b82d132f2c7bdc214">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <rdf:rest rdf:nodeID="Nf80ba439e4aa4db08ff123aca2d83ec1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasExternalId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has external identifier</rdfs:label>
    <rdfs:comment>Associates an entity with an external database identifier that has been accepted as an equivalent identifier for the same entity. This property is used for entity integration and identifier normalization. In contrast to hasDbXref, which records source-provided cross-references without asserting equivalence, hasExternalId indicates that the linked identifier refers to the same integrated entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N01df413cb62b4f85ab1ac514a5415215">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/Rna"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/GuideRNA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
    <rdfs:comment>a non-coding RNA that guides site-specific genome editing or RNA modification, e.g., in CRISPR or RNA editing complexes.</rdfs:comment>
    <rdfs:label>gRNA</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000602"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RnaRegion"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N715a29faf97f437597256a07a68ad5f9">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <rdf:rest rdf:nodeID="Na60360d3a3cd410a9ea2e87d0c6742df"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Taxon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Organism</rdfs:label>
    <rdfs:comment>A class for describing organism with scientific name at the species level or genus level, following binomial nomenclature (e.g., Homo sapiens, Escherichia coli).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/Entity"/>
    <rdfs:seeAlso rdf:resource="http://purl.uniprot.org/core/Taxon"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/EdgeEntity"/>
    <owl:disjointWith rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/hasHGVS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has HGVS</rdfs:label>
    <rdfs:comment>Associates a biological variant with its HGVS-compliant description. This property links a variant entity to a string or identifier that encodes its precise sequence alteration using the standardized nomenclature defined by the Human Genome Variation Society (HGVS).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/chromosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">chromosome</rdfs:label>
    <rdfs:comment>Specifies the chromosome on which a gene or region is located.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://biohackathon.org/resource/faldo#location"/>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Dna"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/variantType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">variant type</rdfs:label>
    <rdfs:comment>Specifies the type of mutation represented by a biological variant. This property categorizes the variant according to the nature of the sequence alteration (e.g., substitution, deletion, insertion, duplication, inversion, or frameshift), enabling consistent classification and filtering of variants based on mutation type. The Range of this property should be ControlledVocabulary.</rdfs:comment>
    <rdfs:domain rdf:nodeID="N37c4b4982d7843179fa3b935da485e38"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/ControlledVocabulary"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2284cdae420d4fb3a45a5e4c19e94331">
    <rdf:first rdf:resource="https://w3id.org/bionext/ontology/PathwayModule"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/bionext/ontology/Dephosphorylation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
    <bn:expectedLeft rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <bn:expectedRight rdf:resource="https://w3id.org/bionext/ontology/Protein"/>
    <rdfs:comment>The process of removing one or more phosphoric (ester or anhydride) residues from a molecule.</rdfs:comment>
    <rdfs:label>Dephosphorylation</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/GO_0016311"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/RelationshipType"/>
  </rdf:Description>
