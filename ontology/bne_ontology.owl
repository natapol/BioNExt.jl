    <rdf:type rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
    <rdfs:comment>A DNA region where RNA polymerase binds to initiate transcription., Initiates transcription by binding RNA polymerase.</rdfs:comment>
    <rdfs:label>Promoter</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/SO_0000167"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/bionext/ontology/DnaRegion"/>
  </rdf:Description>
