    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has subunit</rdfs:label>
    <rdfs:comment>Relates a biological complex to a subunit  that serves as a monomer  of its components .</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://www.biopax.org/release/biopax-level3.owl#component"/>
    <rdfs:domain rdf:resource="https://w3id.org/bionext/ontology/Complex"/>
    <rdfs:range rdf:resource="https://w3id.org/bionext/ontology/NodeEntity"/>
  </rdf:Description>
